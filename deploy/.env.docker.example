# Docker 全栈环境变量（复制为 deploy/.env.docker 后修改）
# 用法：
#   本地构建：docker compose --env-file deploy/.env.docker -f docker-compose.full.yml up -d --build
#   拉 ACR：  docker compose --env-file deploy/.env.docker -f docker-compose.yml up -d

POSTGRES_USER=printfilm
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
POSTGRES_DB=printfilm
REDIS_PASSWORD=replace-with-a-long-random-url-safe-password

ENVIRONMENT=production
SECRET_KEY=replace-with-at-least-32-random-characters
MEDIA_REQUIRE_SIGNATURE=true
MEDIA_SIGNED_URL_TTL_SEC=900
DATABASE_BOOTSTRAP_ENABLED=true

# 生产部署必须换成真实 HTTPS 站点来源；仅填 localhost 会被 API 拒绝启动。
CORS_ORIGINS=https://your-domain.example,https://admin.your-domain.example
PUBLIC_BASE_URL=https://your-domain.example
TRUSTED_PROXY_IPS=
FFMPEG_TIMEOUT_SEC=1800

# 启动后将已注册邮箱提权为管理员（逗号分隔，不造号）
# ADMIN_BOOTSTRAP_EMAILS=you@example.com

ARK_MOCK=false
# TokenFree New API（文字 / 生图 / 生视频同一把 Key）
# 申请：https://www.tokenfree.com → 控制台创建 API 密钥（sk-…）
# 也可启动后在管理后台「系统设置 → 模型」填写，不必改本文件
# Optional at bootstrap: leave blank when the key will be entered in the admin settings.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://www.tokenfree.com/v1
ARK_API_KEY=
# 与站点预设一致（管理端下拉白名单）
MODEL_LLM=kimi-k2.6
MODEL_IMAGE=seedream-5-0-pro
MODEL_VIDEO=seedance-2-5

# 生产必须开启计费；仅演示环境可在独立配置中显式关闭。
BILLING_ENABLED=true
BILLING_MARKUP=1.0
BILLING_SIGNUP_GRANT_FEN=500
BILLING_USD_CNY=7.3

OSS_ENABLED=false
